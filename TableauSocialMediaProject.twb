            <column caption='Total Engagement' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0950320479981568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Likes_Per_Day] + [Follows_Per_Day] + [Posts_Per_Day]' />
            </column>
            <column caption='User Type' datatype='string' name='[Calculation_0950320480632833]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Daily_Minutes_Spent] &gt;= 300 &#13;&#10;AND [Posts_Per_Day] &lt; 5&#13;&#10;THEN &quot;Passive Addicted User&quot;&#13;&#10;&#13;&#10;ELSEIF [Posts_Per_Day] &gt;= 15&#13;&#10;THEN &quot;Active Creator&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_0950320479981568] &gt;= 150&#13;&#10;THEN &quot;Highly Engaged User&quot;&#13;&#10;&#13;&#10;ELSE &quot;Casual User&quot;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Daily Minutes Spent' datatype='integer' default-format='n#,##0;-#,##0' name='[Daily_Minutes_Spent]' role='measure' type='quantitative' />
            <column caption='Follows Per Day' datatype='integer' name='[Follows_Per_Day]' role='dimension' type='quantitative' />
            <column caption='Likes Per Day' datatype='integer' name='[Likes_Per_Day]' role='dimension' type='quantitative' />
            <column caption='Posts Per Day' datatype='integer' default-format='n#,##0;-#,##0' name='[Posts_Per_Day]' role='dimension' type='quantitative' />
