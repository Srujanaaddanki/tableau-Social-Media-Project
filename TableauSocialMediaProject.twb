    <dashboard enable-sort-zone-taborder='true' name='Dashboard 3'>
      <style />
      <size sizing-mode='automatic' />
      <zones>
        <zone h='126923' id='7' type-v2='empty' w='157793' x='-5362' y='-21712'>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='background-color' value='#0290cd' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='47146' id='10' type-v2='text' w='95823' x='3803' y='15385'>
          <formatted-text>
            <run bold='true' fontcolor='#f17b79' fontname='Segoe UI' fontsize='20'>Project Story &amp; Key Insights</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#efe70a' fontname='Tableau Bold' fontsize='14'>Social Media Behavioral Analytics</run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='14'>Æ </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='11'>is</run>
            <run fontcolor='#ffffff' fontname='Tableau Bold' fontsize='11'> an interactive Tableau dashboard project designed to explore how users behave across different social media platforms such as Instagram, Twitter, Facebook, LinkedIn, Snapchat, Pinterest, and TikTok. The project begins with a visually engaging landing page that introduces the story behind digital behavior and user engagement. Using KPI cards, scatter plots, treemaps, and comparative visualizations, the dashboard highlights key insights like the most addictive platform, highest engagement levels, and top content creation activity. Filters and hover tooltips make the dashboard dynamic, allowing users to interact with the data and uncover platform-specific patterns in real time.</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#efe70a' fontname='Tableau Bold' fontsize='11'>The analysis tells</run>
            <run fontcolor='#84c72c' fontname='Tableau Bold' fontsize='11'>Æ </run>
            <run fontcolor='#ffffff' fontname='Tableau Bold' fontsize='11'>a deeper story about how screen time, posting activity, and engagement are connected. The “User Attention vs Interaction” chart reveals how some users spend less time but still achieve high engagement, while others spend excessive time with lower interaction. The treemap and activity charts clearly compare platform popularity and user behavior trends. This project focuses not only on visualization design but also on transforming raw social media data into meaningful business insights through storytelling, interactivity, and clean dashboard presentation.</run>
          </formatted-text>
        </zone>
        <zone alt-text='GitHub Link' h='11538' id='11' is-centered='0' is-scaled='1' param='C:/Users/hp/Pictures/allDowndoadedLogos/GithubIcon.jpg' type-v2='bitmap' url='https://github.com/Srujanaaddanki/tableau-Social-Media-Project' w='5549' x='8666' y='84243'>
